t = 0:0.002:1;
A = 7; 
f = 9; 
o = 1.2; 
U1 = 4.5; 
U2 = 2.5;

s = A*cos(2*pi*f*t);
n = o*randn(size(t));
S = s+n;                

S_filtr = S;
S_filtr(abs(S_filtr) < U2) = 0;

figure;
subplot(2, 1, 1);
plot(t, S, '-.', 'LineWidth', 1); hold on;     
plot(t, S_filtr, '-');

yline(U1, '--b', 'LineWidth', 1);   
yline(U2, '--r', 'LineWidth', 1);  

hold off;
title('Pradinis ir filtruotas signalai');
xlabel('Laikas');
ylabel('Amplitudė');
grid on;
legend('Pradinis signalas', 'Filtruotas signalas', 'U1 riba', 'U2 riba','Location', 'southwest'); 

subplot(2, 1, 2);

index=S>U1;
t_virsinantys = t(index);
S_virsinantys = S(index);

stem(t_virsinantys, S_virsinantys, 'filled', 'MarkerFaceColor', 'k'); 
hold on;

[max_val, max_idx] = max(S);
[min_val, min_idx] = min(S);
plot(t(max_idx), max_val, 'ko', 'MarkerFaceColor', 'k', 'MarkerSize', 6);
plot(t(min_idx), min_val, 'ko', 'MarkerFaceColor', 'k', 'MarkerSize', 6);

hold off;
title('Signalo reikšmės, viršijančios U1');
xlabel('Laikas');
ylabel('Amplitudė');
grid on;
legend('Viršijančios reikšmės', 'Min, Max reikšmės', 'Location', 'southwest'); 
