x=0:0.1:2*pi;
y=x.^3+tan(x);
figure;
plot(x, y, 'bo-');
title('f(x) = x^3 + tan(x))');
xlabel('x');
ylabel('f(x)');
grid on;
legend('f(x) = x^3 + tan(x)', 'Location', 'Southeast');

y1 = exp(x);
y2 = exp(3*x);
y3 = exp(5*x);
figure;
plot(x, y1, 'b');
hold on;
plot(x, y2, 'g');
plot(x, y3, 'm');
hold off;
title('Eksponentes');
xlabel('x');
ylabel('f(x)');
grid on;
legend('f(x) = e^x', 'f(x) = e^{3x}', 'f(x) = e^{5x}', 'Location', 'southeast');


